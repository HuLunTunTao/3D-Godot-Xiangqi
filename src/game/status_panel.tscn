autowrap_mode = 0
text_overrun_behavior = 3
visible = false

[node name="ExternalConnection" type="Button" parent="Content"]
theme_override_colors/font_color = Color(0.666667, 0.705882, 0.729412, 1)
theme_override_font_sizes/font_size = 10
text = "观战连接：未连接  ▸"
flat = true
alignment = 0
